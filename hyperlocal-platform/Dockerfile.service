# Multi-stage Dockerfile for HyperLocal microservices
# Stage 1: Build with Maven
FROM maven:3.9.6-eclipse-temurin-21 AS builder
WORKDIR /build

# Copy shared modules first (for Docker layer caching)
COPY hyperlocal-core/ ./hyperlocal-core/
COPY hyperlocal-common/ ./hyperlocal-common/
COPY hyperlocal-configuration/ ./hyperlocal-configuration/
COPY hyperlocal-integrations/ ./hyperlocal-integrations/
COPY pom.xml ./

# Install shared modules to local Maven cache
RUN mvn install -pl hyperlocal-core,hyperlocal-common,hyperlocal-configuration,hyperlocal-integrations \
    -am -DskipTests --no-transfer-progress

# Copy the target service and build it
ARG SERVICE_PATH
COPY ${SERVICE_PATH}/ ./${SERVICE_PATH}/
RUN mvn package -pl ${SERVICE_PATH} -am -DskipTests --no-transfer-progress

# Stage 2: Minimal JRE runtime
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Add non-root user for security
RUN addgroup -S hyperlocal && adduser -S hyperlocal -G hyperlocal

ARG SERVICE_JAR
COPY --from=builder /build/${SERVICE_JAR} ./app.jar
RUN chown hyperlocal:hyperlocal app.jar
USER hyperlocal

# JVM tuning: container-aware memory management
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC"
ENV SERVER_PORT=8080

EXPOSE ${SERVER_PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:${SERVER_PORT}/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
